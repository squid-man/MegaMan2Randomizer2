<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Avalonia" Version="12.0.2" />
	  <PackageReference Include="Avalonia.Browser" Version="12.0.2" />
	  <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
	  <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
	  <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	  <PackageReference Include="js65.browser" Version="1.0.7" />
	  <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
	  <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.1" />
	  <PackageReference Include="System.IO.Hashing" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RandomizerHost\RandomizerHost.csproj" />
  </ItemGroup>
	<PropertyGroup>
		<PublishTrimmed>false</PublishTrimmed>
		<TrimMode>copyused</TrimMode>
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootAssembly Include="CommunityToolkit.Mvvm" />
		<TrimmerRootAssembly Include="js65.interop" />
		<TrimmerRootAssembly Include="MessageBox.Avalonia" />
		<TrimmerRootAssembly Include="RandomizerHost" />
		<TrimmerRootAssembly Include="System.IO.Hashing" />
		<TrimmerRootAssembly Include="System.Security.Cryptography" />
		<TrimmerRootAssembly Include="Troschuetz.Random" />
	</ItemGroup>
</Project>
